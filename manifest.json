{
  "manifest_version": 3,
  "name": "Testeria",
  "version": "0.1.0",
  "description": "Record & replay user actions di browser (PoC). Tekan F8 atau Ctrl+Shift+Y di halaman untuk mulai/berhenti merekam.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["shared/util.js", "background/background.js"],
    "service_worker": "background/background.js"
  },
  "action": {
    "default_title": "Testeria",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/util.js",
        "content/overlay.js",
        "content/selector.js",
        "content/recorder.js",
        "content/replayer.js",
        "content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-recording": {
      "suggested_key": { "default": "Ctrl+Shift+Y" },
      "description": "Start/stop recording (atau tekan F8 di halaman)"
    },
    "quick-replay": {
      "suggested_key": { "default": "Ctrl+Shift+K" },
      "description": "Buka quick menu replay (atau tekan F9 di halaman)"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "testeria@example.com",
      "strict_min_version": "115.0"
    }
  }
}
